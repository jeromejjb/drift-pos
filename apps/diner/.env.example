# Diner app — copy to .env and replace the REPLACE_... values
# Supabase: Dashboard → Project → Settings → API → anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API (for local testing use http://localhost:3001 — API default port)
VITE_API_URL=http://localhost:3001

# Stripe: Dashboard → Developers → API keys → Publishable key (pk_... only).
# Use pk_test_... for local dev (HTTP). Use pk_live_... only over HTTPS (production).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
