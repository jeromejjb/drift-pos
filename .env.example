# API (server-only; never use STRIPE_SECRET_KEY in frontend)
DATABASE_URL=postgresql://localhost:5432/drift
JWT_SECRET=your-secret-at-least-32-chars  # Use a strong random string in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Integration: comma-separated origins for external apps (e.g. beer app)
# CORS_EXTRA_ORIGINS=https://beerapp.com,https://app.beerapp.com

# P2P testing: when set, you can send to this email from one account (API creates placeholder user in test mode)
# TEST_P2P_RECIPIENT_EMAIL=test@mail.com

# Partner apps: can pass recipient_id=<supabase_uuid> instead of recipient=<email> on the Pay page URL

# For Vite apps: Stripe publishable key only (pk_test_... or pk_live_...). Never put sk_ here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Production: set DATABASE_URL in your host's env (Render, Vercel, etc.). Never commit real credentials.

# Apps
VITE_API_URL=https://api.driftpos.com
RESTAURANT_URL=http://localhost:5174
DINER_URL=http://localhost:5173
LANDING_URL=http://localhost:5175

# Services
OPENAI_API_KEY=sk-...  # For menu import

# For Vite apps (diner, restaurant, landing). Sign-in uses these.
# IMPORTANT: Use the anon PUBLIC key (eyJ... or sb_publishable_...). NEVER use sb_secret_ in frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # anon public key from Supabase Dashboard → Settings → API
# For Node.js API (anon key is fine; service_role only when needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Phone/SMS sign-in (Supabase Send SMS hook). Add to API .env or root .env.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

