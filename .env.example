# ─── Payments (restaurant Connect + diner checkout) ──────────────────────────
# See docs/PAYMENT_SYSTEM_OUTLINE.md for the payment flow end-to-end.
# API (server-only; never use STRIPE_SECRET_KEY in frontend)
DATABASE_URL=postgresql://localhost:5432/drift
# stripe.order-create-payment-intent integration test: runs automatically when DATABASE_URL is localhost.
# For a remote DB (Render, Neon, …), set to 1 to run that test; set to 0 to skip even locally.
# RUN_STRIPE_ORDER_PAYMENT_TEST=1
JWT_SECRET=your-secret-at-least-32-chars  # Use a strong random string in production
# Test mode by default. Use sk_test_ / pk_test_ locally. A live secret is refused
# unless NODE_ENV=production or STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...  # From Stripe Dashboard or: stripe listen --forward-to localhost:3001/api/stripe/webhook

# Platform fee taken as a Stripe application fee on each destination charge.
# Fractions, not percents: 0.025 = 2.5%. Defaults are below Toast (~2.49% + 15¢)
# and Square (~2.6% + 10¢) because the flat fee is 0. Lower PLATFORM_FEE_RATE
# to undercut them further. Volume rate applies after PLATFORM_VOLUME_THRESHOLD
# dollars of paid orders in the current month.
# PLATFORM_FEE_RATE=0.025
# PLATFORM_VOLUME_FEE_RATE=0.015
# PLATFORM_VOLUME_THRESHOLD=50000
# PLATFORM_FEE_FIXED_CENTS=0

# Seed a chargeable Connect test merchant when STRIPE_SECRET_KEY is a real sk_test_ key.
# Set to 0 to skip. Requires Custom accounts enabled in the Stripe Dashboard.
# SEED_STRIPE_CONNECT=1

# Offline unit tests run without Stripe. The live test-mode money flow
# (onboard → pay → payout) runs only when this is 1 and the secret is a real sk_test_ key.
# RUN_STRIPE_E2E=1

# Optional: extra browser origins allowed by the API (comma-separated), e.g. a custom marketing site
# CORS_EXTRA_ORIGINS=https://www.example.com

# P2P testing: when set, you can send to this email from one account (API creates placeholder user in test mode)
# TEST_P2P_RECIPIENT_EMAIL=test@mail.com

# For diner app: Stripe publishable key (pk_test_... for local; pk_live_... only over HTTPS). Never put sk_ here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Production: set DATABASE_URL in your host's env (Render, Vercel, etc.). Never commit real credentials.

# Apps — for local dev use http://localhost:3001 (run npm run dev:pay); production uses your API URL
VITE_API_URL=http://localhost:3001
# Base URL of the restaurant web app (used by the API for Stripe Connect refresh_url / return_url). Production: https://restaurant.driftpos.com (or your host).
RESTAURANT_URL=http://localhost:5175
# Optional override if the restaurant app public URL differs from RESTAURANT_URL
# RESTAURANT_ONBOARDING_BASE_URL=https://restaurant.driftpos.com
DINER_URL=http://localhost:5173
LANDING_URL=http://localhost:5174

# Services
OPENAI_API_KEY=sk-...  # For menu import

# For Vite apps (diner, restaurant, landing). Sign-in uses these.
# Diner loads root .env then apps/diner/.env (diner overrides). Set in either place.
# IMPORTANT: Use the anon PUBLIC key (eyJ... or sb_publishable_...). NEVER use sb_secret_ in frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # anon public key from Supabase Dashboard → Settings → API
# For Node.js API (anon key is fine; service_role only when needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Phone/SMS sign-in (Supabase Send SMS hook). Add to API .env or root .env.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

